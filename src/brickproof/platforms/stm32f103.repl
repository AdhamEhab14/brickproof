// STM32F103 base platform for BrickProof.
// Renode's stock F103 has no RCC, flash controller, CRC, watchdog or bit-banding. The flash
// controller is the one that counts operations and cuts power. @MODELS@ is replaced
// with the models folder when the engine writes the run's platform file.
// A target adapter can append its own lines (extra peripherals, clock fixes).
using "platforms/cpus/stm32f103.repl"

// An STM32 that boots from its main flash shows that flash at address 0 as well, and
// firmware uses it (wolfBoot programs through it). Same memory, two addresses.
flash: @ {
        sysbus 0x08000000;
        sysbus 0x00000000
    }

rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    filename: "@MODELS@/stm32f1_rcc.py"

flashctl: Python.PythonPeripheral @ sysbus 0x40022000
    size: 0x400
    initable: true
    filename: "@MODELS@/stm32f1_flash.py"

// the independent watchdog, clocked by the 40 kHz LSI
iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 40000
    windowOption: false
    defaultPrescaler: 0x4

crc: CRC.STM32_CRC @ sysbus 0x40023000
    series: STM32Series.F4

bitbandPeripherals: Miscellaneous.BitBanding @ sysbus <0x42000000, +0x2000000>
    peripheralBase: 0x40000000

// Where the flash model keeps its test state (op count, cut point, fault latch).
// Plain memory survives a firmware reset; the model's own variables do not.
// The address is unused on the chip and outside the guarded holes.
bpState: Memory.MappedMemory @ sysbus 0x90000000
    size: 0x1000
